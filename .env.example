# 复制为 .env 后填写：cp .env.example .env
# deploy/deploy.sh 会读取这些变量。.env 已加入 .gitignore，不会提交到 git。

# 服务器地址（IP 或域名）
DEPLOY_HOST=your.server.ip
# SSH 端口
DEPLOY_PORT=22
# SSH 用户（服务以 systemd 运行、监听 80 端口，默认用 root）
DEPLOY_USER=root
# SSH 密码（可选）。优先使用密钥免密登录；密钥登录不了时，装了 sshpass 才会用这个密码
DEPLOY_PASSWORD=
# 部署完成后打印的访问地址（可选，默认 http://DEPLOY_HOST/）
DEPLOY_URL=

# 火山引擎豆包语音合成 2.0 凭据（可选，只有重新生成口播 tools/audio/gen_voice.py 时才需要）
VOLC_APP_ID=
VOLC_ACCESS_KEY=
